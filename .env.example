# Chave da API da OpenAI (obrigatória)
OPENAI_API_KEY=

# Modelos usados em cada etapa do pipeline (trocar de modelo = mudar uma linha aqui)
MAP_MODEL=gpt-4o-mini
REDUCE_MODEL=gpt-4o

# Tamanho dos blocos e sobreposição, em palavras
CHUNK_SIZE_WORDS=5000
CHUNK_OVERLAP_WORDS=200

# Quantas chamadas ao modelo barato rodam em paralelo na etapa MAP
MAP_CONCURRENCY=3

# Preços de referência em USD por 1M de tokens (ajustar se a OpenAI mudar os valores)
MAP_MODEL_PRICE_INPUT_PER_1M=0.15
MAP_MODEL_PRICE_OUTPUT_PER_1M=0.60
REDUCE_MODEL_PRICE_INPUT_PER_1M=2.50
REDUCE_MODEL_PRICE_OUTPUT_PER_1M=10.00

# Frações usadas só pra estimar custo antes de rodar (saída esperada / entrada)
ESTIMATE_MAP_OUTPUT_RATIO=0.3
ESTIMATE_REDUCE_OUTPUT_RATIO=0.5
